// emitSyncFrom(): replace the C call with 30 loads (pointer, then value).
// Add to Interpreter:  static size_t offset_registers(){...&p->registers...}
static void emitSyncFrom(Ctx& ctx){
    ctx.li(TB,(uint32_t)(uintptr_t)ctx.interp+(uint32_t)Interpreter::offset_registers());
    for(int i=0;i<15;i++){ ctx.E(ppc_lwz(TA,i*4,TB)); ctx.E(ppc_lwz(RA[i],0,TA)); }
    ctx.li(TA,(uint32_t)(uintptr_t)ctx.interp+(uint32_t)Interpreter::offset_cpsr());
    ctx.E(ppc_lwz(RCPSR,0,TA));
}

