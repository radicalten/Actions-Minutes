Dead-flag elimination (one forward scan per block)
Removes most setNZ/setC/setV sequences — in Thumb, the majority of all emitted instructions.

Pre-decode the block's opcodes into an array (you already read them one at a time; read them all first). For each flag-setting instruction compute which of N/Z/C/V is read before being overwritten by a later unconditional writer in the same block. Anything unknown at block end is live. Pass the live mask to the emitters and skip the dead updates.

enum { F_N=1, F_Z=2, F_C=4, F_V=8, F_ALL=15 };
static const uint8_t kCondReads[16]={F_Z,F_Z,F_C,F_C,F_N,F_N,F_V,F_V,
                                     F_C|F_Z,F_C|F_Z,F_N|F_V,F_N|F_V,F_Z|F_N|F_V,F_Z|F_N|F_V,0,0};

static uint8_t armReads(uint32_t op){
    uint8_t r=kCondReads[op>>28];
    if((op&0x0C000000)==0){                                   // data processing
        uint8_t dop=(op>>21)&15;
        if(dop==5||dop==6||dop==7)r|=F_C;                     // ADC/SBC/RSC
        if(!((op>>25)&1)&&((op>>4)&7)==6&&!((op>>7)&31))r|=F_C; // RRX
    }
    if((op&0x0FBF0FFF)==0x010F0000)r|=F_ALL;                 // MRS
    if((op&0x0F000000)==0x0F000000)r|=F_ALL;                 // SWI: CPSR saved to SPSR
    return r;
}
// Flags definitely written by an unconditional instruction (0 for conditional ones).
static uint8_t armWrites(uint32_t op){
    if((op>>28)!=14)return 0;
    if((op&0x0C000000)==0&&((op>>20)&1)&&(op&0x0F900000)!=0x01000000){
        uint8_t dop=(op>>21)&15;
        bool arith=(dop>=2&&dop<=7)||dop==10||dop==11;
        if(arith)return F_ALL;
        // logical: N,Z always; C only if the shifter produces a carry
        bool imm=(op>>25)&1;
        bool carry = imm ? (((op>>8)&15)!=0) : (((op>>4)&1)||((op>>7)&31)||((op>>5)&3)); 
        return (uint8_t)(F_N|F_Z|(carry?F_C:0));
    }
    if((op&0x0FB0F000)==0x0320F000||(op&0x0FB0FFF0)==0x0120F000)
        return ((op>>16)&8)?F_ALL:0;                          // MSR with flags field
    return 0;
}
static bool armEndsBlock(uint32_t op){
    if(((op>>25)&7)==5)return true;                           // B/BL/BLX
    if((op&0x0FFFFFF0)==0x012FFF10||(op&0x0FFFFFF0)==0x012FFF30)return true;
    if((op&0x0C000000)==0x04000000&&((op>>12)&15)==15&&((op>>20)&1))return true; // LDR pc
    if((op&0x0E100000)==0x08100000&&(op&0x8000))return true;  // LDM {..pc}
    if((op&0x0C000000)==0&&((op>>12)&15)==15&&(op&0x0F900000)!=0x01000000)return true; // ALU pc
    return (op&0x0F000000)==0x0F000000;                       // SWI
}
// Which flags written by ops[i] are needed?
static uint8_t liveAfter(const uint32_t* ops,int i,int n){
    uint8_t live=0,dead=0;
    for(int j=i+1;j<n;j++){
        live|=armReads(ops[j])&~dead;
        dead|=armWrites(ops[j])&~live;
        if(armEndsBlock(ops[j]))break;                        // successor unknown -> rest live
        if((live|dead)==F_ALL)break;
    }
    return (uint8_t)(live|(F_ALL&~dead));
}
