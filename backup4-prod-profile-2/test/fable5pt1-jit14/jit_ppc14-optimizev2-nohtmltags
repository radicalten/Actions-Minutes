static inline uint32_t ppc_b(int32_t byteOff,bool lk=false){
    return (18u<<26)|((uint32_t)byteOff&0x03FFFFFCu)|(lk?1u:0u);
}
static uint32_t* g_exitStub=nullptr;   // emitted once by initJit()

static void emitExitStub(Ctx& ctx){    // expects TE=pc, TF=reason
    emitSpill(ctx);
    ctx.ldInterp(); ctx.ldCpu();
    ctx.E(ppc_addi(TC,1,(int16_t)FRAME_REGSYNC));
    ctx.E(ppc_mr(TD,RCPSR));
    ctx.call((void*)JitHelp_commit);
    emitEpilogue(ctx);
