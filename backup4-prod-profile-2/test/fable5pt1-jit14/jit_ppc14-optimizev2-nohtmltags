// jit_ppc.cpp — normal exits no longer flush
int JitHelp_commit(Interpreter* interp,int cpu,uint32_t* regs,uint32_t cpsr,uint32_t pc,int reason){
    uint32_t** p=interp->getRegisters();
    for(int i=0;i<15;i++)*p[i]=regs[i];
    interp->getCpsrRef()=cpsr;
    *p[15]=pc+((cpsr&(1u<<5))?4u:8u);      // what the interpreter expects r15 to hold
    interp->pipelineDirty=true;            // refill only if the interpreter runs next
    g_exitReason[cpu]=reason; g_exitPC[cpu]=pc;
    return 0;
}
