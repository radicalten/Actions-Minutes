// Word load: address in TB -> result in rd. Falls back to JitHelp_ldr32 (rotated unaligned load).
static void emitLoad32(Ctx& ctx,uint8_t rd){
    ctx.E(ppc_rlwinm(TC,TB,22,10,29));        // TC = (addr>>12)*4
    ctx.E(ppc_lwzx(TC,RMAP,TC));              // page base pointer, 0 = slow
    ctx.E(ppc_rlwinm(TD,TB,0,30,31,true));    // TD = addr&3 ; cr0.EQ if aligned
    ctx.E(ppc_cmpwi7(TC,0));
    size_t b1=ctx.sz(); ctx.E(ppc_bc(4,2,0)); // bne cr0 -> slow   (misaligned)
    size_t b2=ctx.sz(); ctx.E(ppc_bc(12,30,0));// beq cr7 -> slow  (unmapped)  bit 30 = cr7.EQ
    ctx.E(ppc_rlwinm(TD,TB,0,20,31));         // addr & 0xFFF
    ctx.E(ppc_lwbrx(rd,TC,TD));               // little-endian load
    size_t bDone=ctx.sz(); ctx.E(ppc_b(0));
    // slow path
    size_t slow=ctx.sz();
    ctx.base[b1]=(ctx.base[b1]&0xFFFF0003u)|(((slow-b1)*4)&0xFFFCu);
    ctx.base[b2]=(ctx.base[b2]&0xFFFF0003u)|(((slow-b2)*4)&0xFFFCu);
    ctx.E(ppc_stw(TB,FRAME_SCR1,1));
    ctx.ldCore(); ctx.E(ppc_addi(TB,0,ctx.arm7?1:0)); ctx.E(ppc_lwz(TC,FRAME_SCR1,1));
    ctx.call((void*)JitHelp_ldr32);
    if(rd!=TA)ctx.E(ppc_mr(rd,TA));
    ctx.base[bDone]=ppc_b((int32_t)((ctx.sz()-bDone)*4));
}
