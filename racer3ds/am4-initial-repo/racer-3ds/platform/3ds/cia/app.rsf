# makerom ROM spec for the Racer 3DS .cia
#
# The setting that answers "O3DS in high memory mode":
#
#   SystemMode     : 80MB     Old 3DS extended memory mode (exheader SysMode = Dev2).
#                             The console reboots into extended memory mode before the title
#                             starts, and the app then gets 80 MB of application memory
#                             instead of the default 64 MB. This is the same mode Super
#                             Smash Bros. and Pokemon Sun/Moon use on an Old 3DS.
#   SystemModeExt  : Legacy   New 3DS follows the Old 3DS value, so one binary behaves the
#                             same on both models. Change to 124MB/178MB for a New-3DS-only
#                             build with more memory.
#
# The .3dsx built from the same Makefile is launched by hbmenu in the normal 64 MB mode;
# the app prints which mode it actually got on the lower screen either way.
#
# Change UniqueId / ProductCode if you want to install a second build side by side.

BasicInfo:
  Title                   : "Racer 3DS"
  CompanyCode             : "00"
  ProductCode             : "CTR-H-RCR3"
  Logo                    : Homebrew

TitleInfo:
  Category                : Application
  # Template values: `make cia` passes -DAPP_UNIQUE_ID=..., `make cia-64` a different one
  # so both variants can be installed side by side.
  UniqueId                : $(APP_UNIQUE_ID)

AccessControlInfo:
  UseExtSaveData          : false
  MemoryType              : Application
  # `make cia` -> 80MB (O3DS extended memory), `make cia-64` -> 64MB (regular, bisect build)
  SystemMode              : $(APP_SYSTEM_MODE)
  SystemModeExt           : Legacy
  IdealProcessor          : 0
  AffinityMask            : 1
  Priority                : 16
  MaxCpu                  : 0x9E
  HandleTableSize         : 0x200
  DisableDebug            : false
  EnableForceDebug        : false
  CanWriteSharedPage      : true
  CanUsePrivilegedPriority: false
  CanUseNonAlphabetAndNumber: true
  PermitMainFunctionArgument: true
  CanShareDeviceMemory    : true
  RunnableOnSleep         : false
  SpecialMemoryArrange    : false
  CoreVersion             : 2
  DescVersion             : 2
  ReleaseKernelMajor      : "02"
  ReleaseKernelMinor      : "33"

  ServiceAccessControl    :
    - "cfg:u"
    - "dsp::DSP"
    - "fs:USER"
    - "gsp::Gpu"
    - "hid:USER"
    - "ndsp:"
    - "ndm:u"
    - "ptm:sysm"
    - "ptm:u"
    - "ir:USER"

  # Syscall capabilities (index from the ARM11 kernel syscall table). This is the same
  # broad set homebrew exheaders grant, listed explicitly so makerom does not fall back
  # to a 64 MB access descriptor template.
  SystemCallAccess        :
    ControlMemory: 0x01
    QueryMemory: 0x02
    ExitProcess: 0x03
    GetProcessAffinityMask: 0x04
    SetProcessAffinityMask: 0x05
    GetProcessIdealProcessor: 0x06
    SetProcessIdealProcessor: 0x07
    CreateThread: 0x08
    ExitThread: 0x09
    SleepThread: 0x0A
    GetThreadPriority: 0x0B
    SetThreadPriority: 0x0C
    GetThreadAffinityMask: 0x0D
    SetThreadAffinityMask: 0x0E
    GetThreadIdealProcessor: 0x0F
    SetThreadIdealProcessor: 0x10
    GetCurrentProcessorNumber: 0x11
    Run: 0x12
    CreateMutex: 0x13
    ReleaseMutex: 0x14
    CreateSemaphore: 0x15
    ReleaseSemaphore: 0x16
    CreateEvent: 0x17
    SignalEvent: 0x18
    ClearEvent: 0x19
    CreateTimer: 0x1A
    SetTimer: 0x1B
    CancelTimer: 0x1C
    ClearTimer: 0x1D
    CreateMemoryBlock: 0x1E
    MapMemoryBlock: 0x1F
    UnmapMemoryBlock: 0x20
    CreateAddressArbiter: 0x21
    ArbitrateAddress: 0x22
    CloseHandle: 0x23
    WaitSynchronization1: 0x24
    WaitSynchronizationN: 0x25
    SignalAndWait: 0x26
    DuplicateHandle: 0x27
    GetSystemTick: 0x28
    GetHandleInfo: 0x29
    GetSystemInfo: 0x2A
    GetProcessInfo: 0x2B
    GetThreadInfo: 0x2C
    ConnectToPort: 0x2D
    SendSyncRequest1: 0x2E
    SendSyncRequest2: 0x2F
    SendSyncRequest3: 0x30
    SendSyncRequest4: 0x31
    SendSyncRequest: 0x32
    OpenProcess: 0x33
    OpenThread: 0x34
    GetProcessId: 0x35
    GetProcessIdOfThread: 0x36
    GetThreadId: 0x37
    GetResourceLimit: 0x38
    GetResourceLimitLimitValues: 0x39
    GetResourceLimitCurrentValues: 0x3A
    GetThreadContext: 0x3B
    Break: 0x3C
    OutputDebugString: 0x3D
    ControlPerformanceCounter: 0x3E
    CreatePort: 0x47
    CreateSessionToPort: 0x48
    CreateSession: 0x49
    AcceptSession: 0x4A
    ReplyAndReceive1: 0x4B
    ReplyAndReceive2: 0x4C
    ReplyAndReceive3: 0x4D
    ReplyAndReceive4: 0x4E
    ReplyAndReceive: 0x4F
    BindInterrupt: 0x50
    UnbindInterrupt: 0x51
    InvalidateProcessDataCache: 0x52
    StoreProcessDataCache: 0x53
    FlushProcessDataCache: 0x54
    StartInterProcessDma: 0x55
    StopDma: 0x56
    GetDmaState: 0x57
    RestartDma: 0x58
    SetGpuProt: 0x59
    SetWifiEnabled: 0x5A
    DebugActiveProcess: 0x60
    BreakDebugProcess: 0x61
    TerminateDebugProcess: 0x62
    GetProcessDebugEvent: 0x63
    ContinueDebugEvent: 0x64
    GetProcessList: 0x65
    GetThreadList: 0x66
    GetDebugThreadContext: 0x67
    SetDebugThreadContext: 0x68
    QueryDebugProcessMemory: 0x69
    ReadProcessMemory: 0x6A
    WriteProcessMemory: 0x6B
    SetHardwareBreakPoint: 0x6C
    GetDebugThreadParam: 0x6D
    ControlProcessMemory: 0x70
    MapProcessMemory: 0x71
    UnmapProcessMemory: 0x72
    CreateCodeSet: 0x73
    CreateProcess: 0x75
    TerminateProcess: 0x76
    SetProcessResourceLimits: 0x77
    CreateResourceLimit: 0x78
    SetResourceLimitValues: 0x79
    AddCodeSegment: 0x7A
    Backdoor: 0x7B
    KernelSetState: 0x7C
    QueryProcessMemory: 0x7D

SystemControlInfo:
  SaveDataSize            : 0KB
  StackSize               : 0x10000
