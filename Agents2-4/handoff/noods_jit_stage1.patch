+// Diagnostics: per-guest-PC dispatch profile (block hits, stub hits, interpreter
+// fallbacks) per CPU/ISA. Opt-in; used to decide which opcode classes are worth
+// translating natively.
+#ifndef NOODS_JIT_HOTPC
