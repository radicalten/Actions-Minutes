+        *p++ = JitPpc::stw(JitPpc::R7, JitPpc::R31, offPipe1);
+        emitReturn(prefixCycles + 1, false);
+    }
+
+    for (int i = 0; i < slowCount; i++) {
+        const int16_t d = (int16_t)((slow - slowFix[i]) * 4);
+        switch (slowKind[i]) {
+            case 0: *slowFix[i] = JitPpc::beq(d); break;
