# Host-side self-test for the polygon rasterization comparison engine.
#   make run   (from this directory) or `make selftest` from the repo root
CXX ?= g++
CXXFLAGS ?= -std=c++14 -O2 -Wall -Wextra -DPOLY_HOST_TEST

all: poly_selftest

poly_selftest: poly_selftest.cpp ../../Src/src9/poly/poly_ref.cpp
	$(CXX) $(CXXFLAGS) -o $@ poly_selftest.cpp

# scene_meta.txt is generated by the binary itself from the vendored test table,
# so the metadata can never drift from the ROM.
run: poly_selftest
	./poly_selftest meta > scene_meta.txt
	python3 make_reference.py
	./poly_selftest verify .

clean:
	rm -f poly_selftest ref_frames.bin ref_counts.txt

.PHONY: all run clean
