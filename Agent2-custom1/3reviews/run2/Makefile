.SUFFIXES:
# DEVKITPRO may be overridden on the command line / environment, so the same tree
# builds with a locally extracted devkitPPC (see tools/mk_toolchain.sh).
DEVKITPRO ?= /opt/devkitpro
export DEVKITPRO
export DEVKITPPC	:= $(DEVKITPRO)/devkitPPC
include $(DEVKITPPC)/wii_rules
CC 					:= $(DEVKITPPC)/bin/powerpc-eabi-g++
MACHDEP := -DGEKKO -mrvl -mcpu=750 -meabi -mhard-float -fsigned-char -ffast-math -funroll-loops -fauto-inc-dec -finline-functions
INCLUDES += -I$(DEVKITPRO)/portlibs/wii/include -I$(DEVKITPRO)/portlibs/ppc/include -I$(DEVKITPRO)/libogc/include
CXXFLAGS += -O2 \
-DENDIAN_BIG \
$(INCLUDES) $(MACHDEP) 
LDFLAGS += $(CXXFLAGS) \
-Wl,-Map,$(notdir $@).map \
-L$(DEVKITPRO)/portlibs/wii/lib \
-L$(DEVKITPRO)/portlibs/ppc/lib \
-L$(DEVKITPRO)/libogc/lib \
-L$(DEVKITPRO)/libogc/lib/wii \
-lasnd -lwiikeyboard -lfat -lwiiuse -lbte -logc -lm
TARGET  := NooDS-Wii
EXCLUDE := 
SRCDIR 	:= NooDS-Wii
C_SOURCES = $(foreach dir, $(SRCDIR), $(filter-out $(EXCLUDE), $(wildcard $(dir)/*.cpp)))
SOURCES = $(C_SOURCES) 

# jit3, the ARM dynamic recompiler (NooDS-Wii/jit3/).  It lives in a subdirectory
# so the wildcard above does not pick it up.  JIT=0 builds a plain interpreter,
# which is useful for telling a JIT bug apart from an emulation bug.
JIT ?= 1
ifeq ($(JIT),1)
CXXFLAGS += -DJIT3_ENABLED=1 $(EXTRA_CXXFLAGS)
SOURCES  += NooDS-Wii/jit3/armjit.cpp NooDS-Wii/jit3/jit3.cpp
else
# EXTRA_CXXFLAGS belongs to *both* branches: without it here, JIT=0 silently
# drops -DJIT3_EMBED_ROM=1 and the "diagnostic" interpreter build stops being a
# diagnostic build at all (it never autoboots and writes no report, which looks
# exactly like a hang).
CXXFLAGS += -DJIT3_ENABLED=0 $(EXTRA_CXXFLAGS)
endif

OBJECTS = $(SOURCES:.cpp=.o)

# Diagnostic builds bake a ROM into the .dol via EXTRA_CXXFLAGS=-DJIT3_EMBED_ROM=1
# (NooDS-Wii/embed_rom.inc, generated by tools/mk_embed_rom.py).  The app writes
# it to the emulated SD card at boot and loads it from there, so a headless run
# needs nothing from outside the emulator - see the JIT3_EMBED_ROM block in main.cpp.

# Switching JIT on or off changes the compile flags, which make cannot see: the
# objects would be reused and the "new" build would silently be the old one.
# A stamp file turns the flag into a real dependency (and JIT=0 also drops the
# jit3 objects, which are not part of $(OBJECTS) in that configuration).
EXTRA_CXXFLAGS ?=
# echo the effective flags, so a silently dropped -D cannot hide in a build log
$(info [make] JIT=$(JIT) EXTRA_CXXFLAGS='$(EXTRA_CXXFLAGS)')
JIT_STAMP = .jit-flag
# The whole effective flag set, not just JIT/EXTRA_CXXFLAGS: a Makefile edit that
# changes what CXXFLAGS ends up being has to invalidate the objects too.
BUILD_FLAGS = $(CXXFLAGS)
$(shell [ -f $(JIT_STAMP) ] || echo $(BUILD_FLAGS) > $(JIT_STAMP))
ifneq ($(BUILD_FLAGS),$(shell cat $(JIT_STAMP) 2>/dev/null))
$(shell rm -f $(OBJECTS) $(OBJECTS:.o=.d) NooDS-Wii/jit3/*.o NooDS-Wii/jit3/*.d && echo $(BUILD_FLAGS) > $(JIT_STAMP))
endif

ELF2DOL  ?= $(DEVKITPRO)/tools/bin/elf2dol
all: $(TARGET).dol
$(TARGET).dol: $(TARGET).elf
	$(ELF2DOL) $< $@
$(TARGET).elf: $(OBJECTS) $(EXTRA_OBJS)
	$(CC) $^ -o $@ $(LDFLAGS)
%.o: %.cpp
	$(CC) -c $< -o $@ $(CXXFLAGS) -MMD -MP

# Header dependencies, so editing a .h/.hpp rebuilds the .o files that include it
# (without this, a header change silently leaves stale objects behind).
-include $(OBJECTS:.o=.d)
clean:
	rm -f $(TARGET).elf $(TARGET).dol $(TARGET).map $(OBJECTS) $(OBJECTS:.o=.d)
.PHONY: clean test
